// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SearchTerm {
  id        String   @id @default(cuid())
  term      String   @unique
  createdAt DateTime @default(now())

  // Relations
  news News[]

  @@map("search_terms")
}

model News {
  id           String     @id @default(cuid())
  title        String
  summary      String     @db.Text
  url          String     @unique
  searchTermId String
  brandScore   Float?     // Score from 0-5 indicating brand resonance
  labels       String[]   // Labels: innovation, tool, study, report, gossip
  publishedAt  String?    // Original date string from Firecrawl (e.g., "4 minutes ago")
  fetchedAt    DateTime   @default(now())

  // Relations
  searchTerm SearchTerm @relation(fields: [searchTermId], references: [id], onDelete: Cascade)

  @@map("news")
}

model BrandPersona {
  id          String   @id @default(cuid())
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brand_persona")
}

model Newsletter {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  content   String   @db.Text
  newsIds   String[] // IDs of news items used to generate this newsletter
  createdAt DateTime @default(now())

  @@map("newsletters")
}
